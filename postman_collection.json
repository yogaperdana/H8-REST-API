	"item": [
		{
			"name": "Get All Products",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response status code should be 200 (OK)\", () => {\r",
							"  pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response header Content-Type should be application/json\", () => {\r",
							"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
							"});\r",
							"\r",
							"pm.test(\"Each array item should contain object with only specified properties\", () => {\r",
							"  const reqProps = JSON.parse(pm.collectionVariables.get(\"reqFields\"));\r",
							"  pm.response.json().forEach((item) => {\r",
							"    pm.expect(item).to.be.an(\"object\");\r",
							"    pm.expect(Object.keys(item).length).to.equal(reqProps.length);\r",
							"    reqProps.forEach((prop) => {\r",
							"      pm.expect(item).to.have.own.property(prop);\r",
							"    });\r",
							"  });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://{{host}}:{{port}}/product",
					"protocol": "http",
					"host": [
						"{{host}}"
					],
					"port": "{{port}}",
					"path": [
						"product"
					]
				}
			},
			"response": []
		},
		{
			"name": "Add Product with Empty Payload",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response status code should be 400 (Bad Request)\", () => {\r",
							"  pm.response.to.have.status(400);\r",
							"});\r",
							"\r",
							"pm.test(\"Response Content-Type header should be application/json\", () => {\r",
							"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
							"});\r",
							"\r",
							"pm.test(\"Response body data should returning an error message within an object with only one property and key `message`\", () => {\r",
							"  const bodyJSON = pm.response.json();\r",
							"  pm.expect(bodyJSON).to.be.an(\"object\");\r",
							"  pm.expect(Object.keys(bodyJSON).length).to.be.equal(1);\r",
							"  pm.expect(bodyJSON).to.have.own.property(\"message\");\r",
							"  pm.expect(bodyJSON.message).to.be.a(\"string\").and.not.empty;\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
