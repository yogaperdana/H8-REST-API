	"item": [
		{
			"name": "v1.0 - Static Data",
			"item": [
				{
					"name": "Get All Initial Menu",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Response status code should be 200\", () => {\r",
									"  pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Response header Content-Type should be application/json\", () => {\r",
									"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
									"});\r",
									"\r",
									"pm.test(\"Response body data should returning an array contain only 2 items\", () => {\r",
									"  pm.expect(pm.response.json()).to.be.an(\"array\").and.lengthOf(2);\r",
									"});\r",
									"\r",
									"pm.test(\"Each array item should contain object with only specified properties\", () => {\r",
									"  const reqProps = JSON.parse(pm.collectionVariables.get(\"requiredProps\"));\r",
									"  pm.response.json().forEach((item) => {\r",
									"    pm.expect(item).to.be.an(\"object\");\r",
									"    pm.expect(Object.keys(item).length).to.equal(reqProps.length);\r",
									"    reqProps.forEach((prop) => {\r",
									"      pm.expect(item).to.have.own.property(prop);\r",
									"    });\r",
									"  });\r",
									"});\r",
									"\r",
									"pm.test(\"Each object's property should have correct data type and not empty value\", () => {\r",
									"  pm.response.json().forEach((item) => {\r",
									"    pm.expect(item.id_menu).to.be.a(\"number\").and.not.equals(0);\r",
									"    pm.expect(item.name).to.be.a(\"string\").and.not.empty;\r",
									"    pm.expect(item.price).to.be.a(\"number\");\r",
									"    pm.expect(item.variations).to.be.a(\"array\").and.length.above(0);\r",
									"    pm.expect(item.category).to.be.a(\"string\").and.not.empty;\r",
									"  });\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"protocolProfileBehavior": {
						"disabledSystemHeaders": {}
					},
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://{{host}}:{{port}}/menu"
					},
					"response": []
				},
				{
					"name": "Add Menu with Empty Payload",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Response status code should be 415\", () => {\r",
									"  pm.response.to.have.status(415);\r",
									"});\r",
									"\r",
									"pm.test(\"Response Content-Type header should be application/json\", () => {\r",
									"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
									"});\r",
									"\r",
									"pm.test(\"Response body data should returning an error message within an object with only one property and key `message`\", () => {\r",
									"  const bodyJSON = pm.response.json();\r",
									"  pm.expect(bodyJSON).to.be.an(\"object\");\r",
									"  pm.expect(Object.keys(bodyJSON).length).to.be.equal(1);\r",
									"  pm.expect(bodyJSON).to.have.own.property(\"message\");\r",
									"  pm.expect(bodyJSON.message).to.be.a(\"string\").and.not.empty;\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": "http://{{host}}:{{port}}/menu"
					},
					"response": []
				},
				{
					"name": "Add Menu with Bad Payload",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Response status code should be 400\", () => {\r",
									"  pm.response.to.have.status(400);\r",
									"});\r",
									"\r",
									"pm.test(\"Response Content-Type header should be application/json\", () => {\r",
									"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
									"});\r",
									"\r",
									"pm.test(\"Response body data should returning an object contain 2 properties: `errors` and `message`\", () => {\r",
									"  const bodyJSON = pm.response.json();\r",
									"  pm.expect(bodyJSON).to.be.an(\"object\");\r",
									"  pm.expect(Object.keys(bodyJSON).length).to.be.equal(2);\r",
									"  pm.expect(bodyJSON).to.have.own.property(\"message\");\r",
									"  pm.expect(bodyJSON).to.have.own.property(\"errors\");\r",
									"});\r",
									"\r",
									"pm.test(\"Property `error` should returning an object contain explanation of each errors that occur\", () => {\r",
									"  const errJSON = pm.response.json().errors;\r",
									"  pm.expect(errJSON).to.be.an(\"object\");\r",
									"  pm.expect(Object.keys(errJSON).length).to.be.above(0);\r",
									"});\r",
									"\r",
									"pm.test(\"Property `message` should returning an error message\", () => {\r",
									"  pm.expect(pm.response.json().message).to.be.a(\"string\").and.not.empty;\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
